{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ygglet-standalone",
  "version": "0.1.0",
  "identifier": "com.benleadbetter.ygglet-standalone",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../gui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../gui"
    },
    "frontendDist": "../gui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ygglet-standalone",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
